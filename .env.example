# Copy this file to `.env` (same folder) and fill in your own keys.
# `.env` is gitignored — it will never be committed. Never put real keys
# directly in this .example file or anywhere else in the repo.
#
# ALL of these are optional. The agent runs fully offline with none of
# them set, using local sentence-transformers embeddings and regex slot
# extraction — that is the configuration our best score was measured on.

# Upgrades retrieval.py's embedding search from the local
# sentence-transformers model to text-embedding-3-small. Falls back to
# local automatically on any failure (bad key, no network, rate limit).
OPENAI_API_KEY=

# Only used when USE_LLM_EXTRACTION and/or USE_LLM_QUERY_SYNTHESIS is
# also enabled (see below).
GROQ_API_KEY=

# Off by default and deliberately so. LLM slot extraction measured 0.8370
# vs 0.8400 for the regex path on the 200 public sessions (ISSUES.md #9) —
# no gain, plus network dependency, latency, cost, and run-to-run
# non-determinism. Set to 1 only if you want to exercise that path; it is
# the right approach for real messy user input, but not for this
# evaluator's template-generated messages.
USE_LLM_EXTRACTION=

# Narrow LLM role #2, kept separate from extraction above (ISSUES.md #15):
# rewrites the mechanical slot-concatenation query into one fluent
# sentence closer to real catalog text, for semantic_candidates() to
# embed. See ISSUES.md for whether this measured as a net win.
USE_LLM_QUERY_SYNTHESIS=

# Narrow LLM role #3 (ISSUES.md #16): re-ranks the formula's own top ~25
# using BOTH current-turn slots AND the long-term user_profile (otherwise
# entirely unused in this codebase). Retested on the current pipeline, not
# reused from the old pre-fix measurement. See ISSUES.md for the result.
USE_LLM_RERANK=
